<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://ecnu.edu.cn/ontology/academic"
         xmlns="http://ecnu.edu.cn/ontology/academic#">

<owl:Ontology rdf:about="http://ecnu.edu.cn/ontology/academic"/>

<owl:ObjectProperty rdf:about="#authorOf">
  <rdfs:domain rdf:resource="#Scholar"/>
  <rdfs:range rdf:resource="#Publication"/>
  <owl:inverseOf rdf:resource="#hasAuthor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#affiliatedWith">
  <rdfs:domain rdf:resource="#Scholar"/>
  <rdfs:range rdf:resource="#Institution"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#publishedIn">
  <rdfs:domain rdf:resource="#Publication"/>
  <rdfs:range rdf:resource="#Venue"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#cites">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Publication"/>
  <rdfs:range rdf:resource="#Publication"/>
  <owl:inverseOf rdf:resource="#citedBy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#fundedBy">
  <rdfs:domain rdf:resource="#Publication"/>
  <rdfs:range rdf:resource="#Funder"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#coAuthorWith">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Scholar"/>
  <rdfs:range rdf:resource="#Scholar"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#belongsToField">
  <rdfs:domain rdf:resource="#Publication"/>
  <rdfs:domain rdf:resource="#Scholar"/>
  <rdfs:range rdf:resource="#Field"/>
  <owl:inverseOf rdf:resource="#hasField"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#sameAs">
  <rdfs:domain rdf:resource="#Entity"/>
  <rdfs:range rdf:resource="#Entity"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#authoredBy">
  <owl:inverseOf rdf:resource="#authorOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasAuthor">
  <owl:inverseOf rdf:resource="#authorOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#citedBy">
  <owl:inverseOf rdf:resource="#cites"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasField">
  <owl:inverseOf rdf:resource="#belongsToField"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#name">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Entity"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#openalex_id">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Entity"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#year">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Publication"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#doi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Publication"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#cited_by_count">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Publication"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#country">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Institution"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#field_hierarchy_level">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Field"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#description">
  <rdfs:domain rdf:resource="#Entity"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Entity">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Scholar">
  <rdfs:subClassOf rdf:resource="#Entity"/>
</owl:Class>

<owl:Class rdf:about="#Institution">
  <rdfs:subClassOf rdf:resource="#Entity"/>
</owl:Class>

<owl:Class rdf:about="#Publication">
  <rdfs:subClassOf rdf:resource="#Entity"/>
</owl:Class>

<owl:Class rdf:about="#Venue">
  <rdfs:subClassOf rdf:resource="#Entity"/>
</owl:Class>

<owl:Class rdf:about="#Field">
  <rdfs:subClassOf rdf:resource="#Entity"/>
</owl:Class>

<owl:Class rdf:about="#Funder">
  <rdfs:subClassOf rdf:resource="#Entity"/>
</owl:Class>

<owl:Class rdf:about="#Dataset">
  <rdfs:subClassOf rdf:resource="#Entity"/>
</owl:Class>


</rdf:RDF>
